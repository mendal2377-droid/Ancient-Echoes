    {
      "id": "poem_anth_jiuyue",
      "title": { "zh": "九月九日忆山东兄弟", "en": "Thinking of My Brothers on the Double Ninth" },
      "author_id": "poet_anth_wangwei",
      "dynasty": "Tang",
      "form": { "zh": "七言绝句", "en": "qijue (7-char quatrain)" },
      "date_composed": { "year": 718, "precision": "unknown" },
      "body": {
        "zh": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"],
        "en": ["Alone, a stranger in a strange land,", "at every festival I miss my kin the more.", "From afar I know my brothers climb the heights,", "each wearing dogwood—one man short."]
      },
      "place_links": [],
      "themes": { "zh": ["思乡", "佳节", "登高"], "en": ["homesickness", "festival", "ascending"] },
      "emotions": [
