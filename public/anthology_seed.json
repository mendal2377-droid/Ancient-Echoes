        { "type": "离别", "primary": false, "percentage": 45, "confidence": "medium" }
      ]
    },
    {
      "id": "poem_anth_songyuaner",
      "title": { "zh": "送元二使安西", "en": "Farewell to Yuan the Second, Bound for Anxi" },
      "author_id": "poet_anth_wangwei",
      "dynasty": "Tang",
      "form": { "zh": "七言绝句", "en": "qijue (7-char quatrain)" },
      "date_composed": { "year": 738, "precision": "unknown" },
      "body": {
        "zh": ["渭城朝雨浥轻尘，", "客舍青青柳色新。", "劝君更尽一杯酒，", "西出阳关无故人。"],
        "en": ["Morning rain in Weicheng dampens the light dust;", "by the inn the willows are fresh and green.", "Let me urge on you one more cup of wine—", "west of Yang Pass there will be no old friends."]
      },
      "place_links": [],
      "themes": { "zh": ["离别", "雨", "酒"], "en": ["parting", "rain", "wine"] },
