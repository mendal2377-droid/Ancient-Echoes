    {
      "id": "poem_anth_jingyesi",
      "title": { "zh": "静夜思", "en": "Quiet Night Thoughts" },
      "author_id": "poet_anth_libai",
      "dynasty": "Tang",
      "form": { "zh": "五言绝句", "en": "wujue (5-char quatrain)" },
      "date_composed": { "year": 730, "precision": "unknown" },
      "body": {
        "zh": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"],
        "en": ["Before my bed, the bright moonlight—", "I wonder if it is frost on the ground.", "I lift my head and gaze at the moon,", "then lower it, longing for home."]
      },
      "place_links": [],
      "themes": { "zh": ["月", "思乡", "夜"], "en": ["moon", "homesickness", "night"] },
      "emotions": [
        { "type": "思乡", "primary": true, "percentage": 95, "confidence": "high" },
        { "type": "独居", "primary": false, "percentage": 40, "confidence": "medium" }
      ]
    },
    {
      "id": "poem_anth_chunxiao",
      "title": { "zh": "春晓", "en": "Spring Dawn" },
      "author_id": "poet_anth_menghaoran",
      "dynasty": "Tang",
      "form": { "zh": "五言绝句", "en": "wujue (5-char quatrain)" },
      "date_composed": { "year": 720, "precision": "unknown" },
      "body": {
        "zh": ["春眠不觉晓，", "处处闻啼鸟。", "夜来风雨声，", "花落知多少。"],
        "en": ["Asleep in spring, I missed the dawn;", "now everywhere I hear the birds.", "In the night came the sound of wind and rain—", "how many blossoms must have fallen?"]
      },
      "place_links": [],
      "themes": { "zh": ["春", "花", "山水"], "en": ["spring", "blossoms", "landscape"] },
      "emotions": [
        { "type": "山水", "primary": true, "percentage": 85, "confidence": "high" },
        { "type": "独居", "primary": false, "percentage": 30, "confidence": "medium" }
      ]
    },
    {
      "id": "poem_anth_dengguanquelou",
      "title": { "zh": "登鹳雀楼", "en": "Climbing Stork Tower" },
      "author_id": "poet_anth_wangzhihuan",
      "dynasty": "Tang",
      "form": { "zh": "五言绝句", "en": "wujue (5-char quatrain)" },
      "date_composed": { "year": 710, "precision": "unknown" },
      "body": {
        "zh": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"],
        "en": ["The white sun sets behind the mountains,", "the Yellow River flows into the sea.", "To see a thousand miles farther,", "climb one more storey of the tower."]
      },
      "place_links": [],
      "themes": { "zh": ["山水", "江河", "志"], "en": ["landscape", "river", "aspiration"] },
      "emotions": [
        { "type": "山水", "primary": true, "percentage": 85, "confidence": "high" },
        { "type": "怀古", "primary": false, "percentage": 25, "confidence": "low" }
      ]
    },
    {
      "id": "poem_anth_xiangsi",
      "title": { "zh": "相思", "en": "Longing" },
      "author_id": "poet_anth_wangwei",
      "dynasty": "Tang",
      "form": { "zh": "五言绝句", "en": "wujue (5-char quatrain)" },
      "date_composed": { "year": 740, "precision": "unknown" },
      "body": {
        "zh": ["红豆生南国，", "春来发几枝。", "愿君多采撷，", "此物最相思。"],
        "en": ["Red beans grow in the southern land;", "in spring they put forth a few new sprigs.", "Gather many of them, I pray you—", "nothing speaks of longing like these."]
      },
      "place_links": [],
      "themes": { "zh": ["相思", "红豆", "春"], "en": ["longing", "red beans", "spring"] },
      "emotions": [
        { "type": "相思", "primary": true, "percentage": 95, "confidence": "high" },
        { "type": "友情", "primary": false, "percentage": 40, "confidence": "medium" }
      ]
    },
    {
      "id": "poem_anth_jiangxue",
      "title": { "zh": "江雪", "en": "River Snow" },
      "author_id": "poet_anth_liuzongyuan",
      "dynasty": "Tang",
      "form": { "zh": "五言绝句", "en": "wujue (5-char quatrain)" },
      "date_composed": { "year": 805, "precision": "unknown" },
      "body": {
        "zh": ["千山鸟飞绝，", "万径人踪灭。", "孤舟蓑笠翁，", "独钓寒江雪。"],
        "en": ["A thousand hills, and no bird flies;", "ten thousand paths, no human trace.", "A lone boat, an old man in straw cape,", "fishing alone the cold river snow."]
      },
      "place_links": [],
      "themes": { "zh": ["雪", "孤独", "山水"], "en": ["snow", "solitude", "landscape"] },
      "emotions": [
