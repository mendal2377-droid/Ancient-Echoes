    {
      "id": "poem_anth_shanxing",
      "title": { "zh": "山行", "en": "Travelling in the Mountains" },
      "author_id": "poet_anth_dumu",
      "dynasty": "Tang",
      "form": { "zh": "七言绝句", "en": "qijue (7-char quatrain)" },
      "date_composed": { "year": 835, "precision": "unknown" },
      "body": {
        "zh": ["远上寒山石径斜，", "白云生处有人家。", "停车坐爱枫林晚，", "霜叶红于二月花。"],
        "en": ["Far up the cold mountain, a stone path slants;", "where white clouds are born, a house or two.", "I stop the cart, in love with the maple woods at dusk—", "frost-touched leaves are redder than spring flowers."]
      },
      "place_links": [],
      "themes": { "zh": ["山", "秋", "枫"], "en": ["mountain", "autumn", "maple"] },
      "emotions": [
        { "type": "山水", "primary": true, "percentage": 90, "confidence": "high" },
        { "type": "怀古", "primary": false, "percentage": 25, "confidence": "low" }
      ]
