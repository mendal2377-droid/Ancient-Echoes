    {
      "id": "poem_anth_luzhai",
      "title": { "zh": "鹿柴", "en": "Deer Enclosure" },
      "author_id": "poet_anth_wangwei",
      "dynasty": "Tang",
      "form": { "zh": "五言绝句", "en": "wujue (5-char quatrain)" },
      "date_composed": { "year": 745, "precision": "unknown" },
      "body": {
        "zh": ["空山不见人，", "但闻人语响。", "返景入深林，", "复照青苔上。"],
        "en": ["Empty mountain—no one to be seen,", "yet the sound of voices is heard.", "Returning light enters the deep woods,", "shining again upon the green moss."]
      },
      "place_links": [],
      "themes": { "zh": ["山水", "空", "静"], "en": ["landscape", "emptiness", "stillness"] },
      "emotions": [
