    {
      "id": "poem_anth_fengqiao",
      "title": { "zh": "枫桥夜泊", "en": "Night Mooring at Maple Bridge" },
      "author_id": "poet_anth_zhangji",
      "dynasty": "Tang",
      "form": { "zh": "七言绝句", "en": "qijue (7-char quatrain)" },
      "date_composed": { "year": 756, "precision": "unknown" },
      "body": {
        "zh": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"],
        "en": ["The moon sets, a crow cries, frost fills the sky;", "river maples, fishing fires, and sorrow-laden sleep.", "Beyond Gusu's walls, at Cold Mountain Temple,", "the midnight bell reaches the traveller's boat."]
      },
      "place_links": [],
      "themes": { "zh": ["夜", "月", "羁旅"], "en": ["night", "moon", "travel"] },
      "emotions": [
