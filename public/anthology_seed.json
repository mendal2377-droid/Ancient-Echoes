    {
      "id": "poem_anth_huanghelou",
      "title": { "zh": "黄鹤楼送孟浩然之广陵", "en": "Seeing Off Meng Haoran at Yellow Crane Tower" },
      "author_id": "poet_anth_libai",
      "dynasty": "Tang",
      "form": { "zh": "七言绝句", "en": "qijue (7-char quatrain)" },
      "date_composed": { "year": 730, "precision": "unknown" },
      "body": {
        "zh": ["故人西辞黄鹤楼，", "烟花三月下扬州。", "孤帆远影碧空尽，", "唯见长江天际流。"],
        "en": ["My old friend takes leave of the Yellow Crane Tower in the west,", "in the mist and blossoms of the third month, going down to Yangzhou.", "His lone sail's far shadow fades into the blue,", "and I see only the Yangtze flowing to the edge of the sky."]
      },
      "place_links": [],
      "themes": { "zh": ["离别", "友情", "江"], "en": ["parting", "friendship", "river"] },
