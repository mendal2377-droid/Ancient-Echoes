# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Without this key the app still works: /api/oracle returns 503 and the client
# silently falls back to the local keyword matcher. With it, DeepSeek reads the
# moment and chooses which poems answer it.
#
# Get a key at https://platform.deepseek.com
#
# Local:  put it in .env, then `npm run dev`
# Vercel: Project → Settings → Environment Variables → DEEPSEEK_API_KEY
#         (do NOT prefix with VITE_ — that would inline it into the client bundle)
DEEPSEEK_API_KEY=
