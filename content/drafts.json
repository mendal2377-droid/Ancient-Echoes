[
  { "id": "poem_anth_jingyesi", "poet_id": "poet_anth_libai", "title_zh": "静夜思", "author_zh": "李白", "dynasty": "Tang", "body_zh": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"] },
  { "id": "poem_anth_chunxiao", "poet_id": "poet_anth_menghaoran", "title_zh": "春晓", "author_zh": "孟浩然", "dynasty": "Tang", "body_zh": ["春眠不觉晓，", "处处闻啼鸟。", "夜来风雨声，", "花落知多少。"] },
  { "id": "poem_anth_dengguanquelou", "poet_id": "poet_anth_wangzhihuan", "title_zh": "登鹳雀楼", "author_zh": "王之涣", "dynasty": "Tang", "body_zh": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"] },
  { "id": "poem_anth_xiangsi", "poet_id": "poet_anth_wangwei", "title_zh": "相思", "author_zh": "王维", "dynasty": "Tang", "body_zh": ["红豆生南国，", "春来发几枝。", "愿君多采撷，", "此物最相思。"] },
  { "id": "poem_anth_jiangxue", "poet_id": "poet_anth_liuzongyuan", "title_zh": "江雪", "author_zh": "柳宗元", "dynasty": "Tang", "body_zh": ["千山鸟飞绝，", "万径人踪灭。", "孤舟蓑笠翁，", "独钓寒江雪。"] },
  { "id": "poem_anth_shanxing", "poet_id": "poet_anth_dumu", "title_zh": "山行", "author_zh": "杜牧", "dynasty": "Tang", "body_zh": ["远上寒山石径斜，", "白云生处有人家。", "停车坐爱枫林晚，", "霜叶红于二月花。"] },
  { "id": "poem_anth_jiuyue", "poet_id": "poet_anth_wangwei", "title_zh": "九月九日忆山东兄弟", "author_zh": "王维", "dynasty": "Tang", "body_zh": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"] },
  { "id": "poem_anth_songyuaner", "poet_id": "poet_anth_wangwei", "title_zh": "送元二使安西", "author_zh": "王维", "dynasty": "Tang", "body_zh": ["渭城朝雨浥轻尘，", "客舍青青柳色新。", "劝君更尽一杯酒，", "西出阳关无故人。"] },
  { "id": "poem_anth_fengqiao", "poet_id": "poet_anth_zhangji", "title_zh": "枫桥夜泊", "author_zh": "张继", "dynasty": "Tang", "body_zh": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"] },
  { "id": "poem_anth_luzhai", "poet_id": "poet_anth_wangwei", "title_zh": "鹿柴", "author_zh": "王维", "dynasty": "Tang", "body_zh": ["空山不见人，", "但闻人语响。", "返景入深林，", "复照青苔上。"] },
  { "id": "poem_anth_huanghelou", "poet_id": "poet_anth_libai", "title_zh": "黄鹤楼送孟浩然之广陵", "author_zh": "李白", "dynasty": "Tang", "body_zh": ["故人西辞黄鹤楼，", "烟花三月下扬州。", "孤帆远影碧空尽，", "唯见长江天际流。"] },

  { "id": "poem_anth_wanglushan", "poet_id": "poet_anth_libai", "title_zh": "望庐山瀑布", "author_zh": "李白", "dynasty": "Tang", "body_zh": ["日照香炉生紫烟，", "遥看瀑布挂前川。", "飞流直下三千尺，", "疑是银河落九天。"] },
  { "id": "poem_anth_zaofa", "poet_id": "poet_anth_libai", "title_zh": "早发白帝城", "author_zh": "李白", "dynasty": "Tang", "body_zh": ["朝辞白帝彩云间，", "千里江陵一日还。", "两岸猿声啼不住，", "轻舟已过万重山。"] }
]
